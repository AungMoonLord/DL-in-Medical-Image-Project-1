======================================================================
CONFIG
======================================================================
project:
  name: thai-char-cnn
  num_classes: 72
  seed: 42
  deterministic: true
paths:
  raw_dir: data/finetune_raw
  aug_dir: data/finetune_augmented
  splits_dir: data/finetune_splits
  train_csv: data/finetune_splits/train.csv
  val_csv: data/finetune_splits/val.csv
  class_map: data/splits/class_map.json
  ckpt_dir: outputs/checkpoints_finetune
  log_dir: outputs/logs_finetune
  figure_dir: outputs/figures_finetune
data:
  image_size: 224
  in_channels: 3
  pad_color: 255
  auto_invert: true
  normalize:
    mean:
    - 0.485
    - 0.456
    - 0.406
    std:
    - 0.229
    - 0.224
    - 0.225
split:
  ratio: 0.8
  stratify: true
  min_val_per_class: 1
  singleton_policy: val_first
  enforce_no_leakage: true
augmentation:
  online:
    rotate_limit: 10
    scale_limit: 0.15
    shear_limit: 8
    translate_percent: 0.06
    elastic:
      enabled: true
      alpha: 30
      sigma: 6
      p: 0.4
    grid_distortion:
      enabled: false
      distort_limit: 0.2
      p: 0.3
    brightness_contrast: 0.2
    morphology:
      enabled: true
      p: 0.3
      max_kernel: 3
    coarse_dropout:
      enabled: true
      p: 0.2
      max_holes: 4
      max_size: 12
  offline:
    tail_threshold: 80
    target_count: 80
    strength: strong
  forbidden:
    horizontal_flip: false
    vertical_flip: false
    rotate_90: false
    color_invert: false
model:
  backbone: tf_efficientnet_b0.ns_jft_in1k
  pretrained: true
  head: arcface
  embedding_dim: 512
  dropout: 0.3
  drop_path: 0.2
  arcface:
    scale: 30.0
    margin: 0.3
    easy_margin: false
    adaptive_margin: true
    margin_min: 0.1
    margin_max: 0.35
loss:
  type: logit_adjusted
  label_smoothing: 0.1
  tau: 1.0
  focal_gamma: 2.0
  mixup:
    enabled: true
    alpha: 0.2
    tail_aware: true
train:
  stage1:
    enabled: true
    epochs: 10
    batch_size: 64
    sampler: instance
    freeze_backbone: false
    optimizer: adamw
    lr: 0.0001
    backbone_lr_mult: 0.05
    weight_decay: 0.01
    scheduler: cosine
    warmup_epochs: 1
    min_lr: 1.0e-06
  stage2:
    enabled: true
    epochs: 5
    batch_size: 64
    sampler: instance
    freeze_backbone: true
    optimizer: adamw
    lr: 0.0002
    weight_decay: 0.0001
    scheduler: cosine
    warmup_epochs: 1
    min_lr: 1.0e-06
hardware:
  device: cuda
  amp: true
  amp_dtype: bfloat16
  channels_last: true
  compile: false
  num_workers: 4
  pin_memory: true
  persistent_workers: true
  prefetch_factor: 4
  cudnn_benchmark: true
  grad_accum_steps: 1
  max_grad_norm: 5.0
eval:
  primary_metric: macro_f1
  monitor_mode: max
  early_stopping:
    enabled: true
    patience: 12
    min_delta: 0.001
  tta:
    enabled: true
    n_views: 5
  report:
    per_class_recall: true
    confusion_matrix: true
    confusion_top_k: 25
    gradcam_samples: 12
    confusion_groups:
    - - ข
      - ฃ
    - - ท
      - ฑ
    - - พ
      - ผ
      - ฝ
      - ฟ
      - ฬ
    - - ก
      - ภ
      - ถ
      - ฤ
    - - ด
      - ต
      - ค
    - - ิ
      - ี
      - ึ
      - ื
    - - ่
      - ้
      - ๊
    - - ช
      - ซ
    - - า
      - ว
      - ๅ
    - - ็
      - ๘
    - - ๔
      - ๕
logging:
  level: INFO
  tensorboard: true
  save_history_csv: true
  log_interval: 20
  save_last: true
  save_best: true
_config_file: configs\finetune.yaml
experiment:
  name: effnet_b0_finetune
  tag: v2
  notes: 'Two-stage decoupled training with EfficientNet-B0 + ArcFace + Logit Adjustment
    Tail classes augmented to 200 samples.

    '
